            { "id": "m-1", "name": "evento", "value": "={{ $json.body.evento || $json.evento || 'NOTIFICACION_MAXIMUS' }}", "type": "string" },
            { "id": "m-2", "name": "destinatario_principal", "value": "={{ $json.body.cliente_email || $json.body.email_cliente || $json.body.email || $json.body.asesor_email || 'contacto@maximusinmobiliaria.com' }}", "type": "string" },
