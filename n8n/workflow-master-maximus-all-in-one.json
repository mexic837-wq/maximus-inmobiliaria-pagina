        "emailType": "html",
        "html": "=<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#071714;font-family:'Plus Jakarta Sans',Arial,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:32px 16px;background:#071714;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #10B981;\"><tr><td style=\"background:linear-gradient(135deg,#0B4A3F 0%,#062E26 100%);padding:34px 32px;text-align:center;border-bottom:3px solid #D1D5DB;\"><div style=\"font-size:11px;letter-spacing:3px;color:#10B981;font-weight:800;\">SISTEMA CENTRAL DE AUTOMATIZACIÓN</div><h1 style=\"color:#ffffff;margin:8px 0 0;font-size:22px;\">MAXIMUS INMOBILIARIA</h1><p style=\"color:#D1D5DB;margin:6px 0 0;font-size:13px;\">Evento: {{ $json.evento }} • {{ $json.titulo_resumen }}</p></td></tr><tr><td style=\"padding:32px;\"><p style=\"font-size:14px;color:#374151;line-height:1.6;\">Se ha ejecutado automáticamente una transacción desde el ecosistema web/CRM de <strong>MAXIMUS Inmobiliaria</strong>:</p><pre style=\"background:#0B1512;color:#10B981;padding:18px;border-radius:12px;font-size:12px;overflow-x:auto;\">{{ $json.payload_json }}</pre></td></tr><tr><td style=\"background:#0B1512;color:#9CA3AF;padding:18px;text-align:center;font-size:11px;\">MAXIMUS Inmobiliaria C.A. • San Diego, Edo. Carabobo</td></tr></table></td></tr></table></body></html>",
        "options": {}
      },
