    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=✅ Tu membresía MAXIMUS Pro está activa · {{ $json.codigo }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"color-scheme\" content=\"light only\">\n  <title>Tu membresía MAXIMUS Pro está activa</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#F4F7F6; font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;\">\n  <!-- Pre-header (texto de vista previa en la bandeja de entrada) -->\n  <div style=\"display:none; max-height:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px; color:#F4F7F6;\">\n    Pago confirmado · {{ $json.plan }} activo hasta el {{ $json.vence }}\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F4F7F6; padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px; width:100%; background-color:#FFFFFF; border-radius:20px; overflow:hidden; box-shadow:0 12px 32px rgba(11,74,63,0.10); border:1px solid #E2E8F0;\">\n\n          <!-- Barra superior cromo & esmeralda -->\n          <tr>\n            <td style=\"height:6px; background:linear-gradient(90deg, #0B4A3F 0%, #10B981 50%, #CBD5E1 100%);\"></td>\n          </tr>\n\n          <!-- Cabecera con logo -->\n          <tr>\n            <td align=\"center\" style=\"background:linear-gradient(135deg, #071714 0%, #0B4A3F 100%); padding:34px 32px 28px 32px; border-bottom:2px solid #10B981;\">\n              <img src=\"{{ $json.logo_url }}\" width=\"72\" alt=\"MAXIMUS\" style=\"display:block; width:72px; height:auto; margin:0 auto 16px auto; border:0; outline:none; text-decoration:none; font-size:14px; font-weight:800; color:#F8FAFC;\">\n              <h1 style=\"margin:0; font-size:24px; font-weight:800; letter-spacing:2px; color:#F8FAFC; text-transform:uppercase;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span>\n              </h1>\n              <p style=\"margin:4px 0 0 0; font-size:11px; font-weight:700; letter-spacing:4px; color:#CBD5E1; text-transform:uppercase;\">\n                INMOBILIARIA\n              </p>\n            </td>\n          </tr>\n\n          <!-- Cuerpo -->\n          <tr>\n            <td style=\"padding:38px 36px 30px 36px;\">\n              <div style=\"margin-bottom:18px;\">\n                <span style=\"display:inline-block; background-color:#ECFDF5; border:1px solid #A7F3D0; color:#059669; border-radius:999px; padding:6px 14px; font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;\">\n                  ✓ Pago confirmado\n                </span>\n              </div>\n\n              <h2 style=\"margin:0 0 12px 0; font-size:22px; font-weight:800; color:#0F172A; line-height:1.3;\">\n                ¡Bienvenido a MAXIMUS Pro, {{ $json.nombre }}!\n              </h2>\n\n              <p style=\"margin:0 0 26px 0; font-size:15px; line-height:1.65; color:#475569;\">\n                Recibimos tu pago y tu cuenta ya cuenta con permisos de <strong style=\"color:#0B4A3F;\">Asesor Pro</strong>. Tu membresía está vigente hasta el <strong style=\"color:#0F172A;\">{{ $json.vence }}</strong>.\n              </p>\n\n              <!-- Comprobante -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F8FAFC; border:1px solid #E2E8F0; border-left:4px solid #10B981; border-radius:14px; margin-bottom:24px;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <p style=\"margin:0 0 12px 0; font-size:11px; font-weight:800; letter-spacing:1.5px; color:#0B4A3F; text-transform:uppercase;\">\n                      Comprobante de pago\n                    </p>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; width:38%; border-bottom:1px solid #E2E8F0;\">Código</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; font-family:monospace; border-bottom:1px solid #E2E8F0;\">{{ $json.codigo }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Plan</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $json.plan }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Método</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $json.metodo }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Fecha</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:600; color:#475569; border-bottom:1px solid #E2E8F0;\">{{ $json.fecha }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:9px 0 2px 0; font-size:13px; color:#64748B;\">Total</td>\n                        <td style=\"padding:9px 0 2px 0; font-size:18px; font-weight:800; color:#059669;\">US$ {{ $json.monto }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Qué incluye -->\n              <p style=\"margin:0 0 10px 0; font-size:11px; font-weight:800; letter-spacing:1.5px; color:#0B4A3F; text-transform:uppercase;\">\n                Ya puedes usar\n              </p>\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:5px 0; font-size:14px; color:#334155;\"><span style=\"color:#10B981; font-weight:800;\">✓</span>&nbsp; Carga ilimitada de inmuebles al catálogo</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:5px 0; font-size:14px; color:#334155;\"><span style=\"color:#10B981; font-weight:800;\">✓</span>&nbsp; CRM de prospectos y seguimiento</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:5px 0; font-size:14px; color:#334155;\"><span style=\"color:#10B981; font-weight:800;\">✓</span>&nbsp; Cotizador express de comisiones</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:5px 0; font-size:14px; color:#334155;\"><span style=\"color:#10B981; font-weight:800;\">✓</span>&nbsp; Colecciones VIP y WhatsApp directo en tus propiedades</td>\n                </tr>\n              </table>\n\n              <!-- CTA -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ $json.url_dashboard }}\" style=\"display:inline-block; background:linear-gradient(135deg, #0B4A3F 0%, #10B981 100%); background-color:#0B4A3F; color:#FFFFFF; text-decoration:none; padding:15px 34px; border-radius:12px; font-size:13px; font-weight:800; letter-spacing:1px; text-transform:uppercase; box-shadow:0 6px 16px rgba(16,185,129,0.25);\">\n                      Ir a mi panel →\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin:24px 0 0 0; font-size:12px; line-height:1.6; color:#64748B; text-align:center;\">\n                Si ya tenías la sesión abierta, ciérrala y vuelve a entrar para ver los cambios.<br>\n                ¿Dudas con tu pago? <a href=\"{{ $json.url_whatsapp }}\" style=\"color:#059669; font-weight:700; text-decoration:none;\">Escríbenos por WhatsApp</a>.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#111827; padding:26px 32px; border-top:3px solid #10B981; text-align:center;\">\n              <p style=\"margin:0 0 6px 0; font-size:14px; font-weight:800; color:#F8FAFC; letter-spacing:1.5px;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span> <span style=\"font-weight:500; font-size:11px; color:#CBD5E1; letter-spacing:2px;\">INMOBILIARIA</span>\n              </p>\n              <p style=\"margin:0 0 12px 0; font-size:12px; color:#94A3B8; line-height:1.5;\">\n                Experiencia, exclusividad y respaldo legal en cada inversión.<br>\n                San Cristóbal, Estado Táchira · Venezuela\n              </p>\n              <p style=\"margin:0; font-size:11px; color:#64748B;\">\n                © 2026 MAXIMUS Inmobiliaria. Conserva este correo como comprobante.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {
          "appendAttribution": false,
          "senderName": "MAXIMUS Inmobiliaria"
        }
      },
