        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"color-scheme\" content=\"light only\">\n  <title>Nueva membresía Pro activada</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#F4F7F6; font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;\">\n  <div style=\"display:none; max-height:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px; color:#F4F7F6;\">\n    {{ $('Preparar datos').item.json.nombre }} activó MAXIMUS Pro · US$ {{ $('Preparar datos').item.json.monto }} · {{ $('Preparar datos').item.json.metodo }}\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F4F7F6; padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px; width:100%; background-color:#FFFFFF; border-radius:20px; overflow:hidden; box-shadow:0 12px 32px rgba(11,74,63,0.10); border:1px solid #E2E8F0;\">\n\n          <tr>\n            <td style=\"height:6px; background:linear-gradient(90deg, #0B4A3F 0%, #10B981 50%, #CBD5E1 100%);\"></td>\n          </tr>\n\n          <!-- Cabecera compacta con logo -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg, #071714 0%, #0B4A3F 100%); padding:22px 28px; border-bottom:2px solid #10B981;\">\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td width=\"56\" valign=\"middle\">\n                    <img src=\"{{ $('Preparar datos').item.json.logo_url }}\" width=\"44\" alt=\"MAXIMUS\" style=\"display:block; width:44px; height:auto; border:0; font-size:11px; font-weight:800; color:#F8FAFC;\">\n                  </td>\n                  <td valign=\"middle\" style=\"padding-left:4px;\">\n                    <p style=\"margin:0; font-size:16px; font-weight:800; letter-spacing:2px; color:#F8FAFC; text-transform:uppercase;\">MAXIMUS<span style=\"color:#10B981;\">.</span></p>\n                    <p style=\"margin:2px 0 0 0; font-size:10px; font-weight:700; letter-spacing:3px; color:#CBD5E1; text-transform:uppercase;\">Aviso interno</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:30px 32px 26px 32px;\">\n              <span style=\"display:inline-block; background-color:#ECFDF5; border:1px solid #A7F3D0; color:#059669; border-radius:999px; padding:6px 14px; font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;\">\n                💰 Nueva membresía Pro\n              </span>\n\n              <h2 style=\"margin:16px 0 8px 0; font-size:20px; font-weight:800; color:#0F172A; line-height:1.3;\">\n                {{ $('Preparar datos').item.json.nombre }} activó su plan\n              </h2>\n              <p style=\"margin:0 0 22px 0; font-size:14px; line-height:1.6; color:#475569;\">\n                El pago se confirmó automáticamente y el rol de <strong style=\"color:#0B4A3F;\">Asesor Pro</strong> ya quedó aplicado. No necesitas hacer nada.\n              </p>\n\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F8FAFC; border:1px solid #E2E8F0; border-left:4px solid #10B981; border-radius:14px; margin-bottom:22px;\">\n                <tr>\n                  <td style=\"padding:18px 22px;\">\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; width:34%; border-bottom:1px solid #E2E8F0;\">Asesor</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.nombre }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Correo</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:600; color:#334155; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.email || 'N/D' }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Teléfono</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:600; color:#334155; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.telefono }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Código</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; font-family:monospace; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.codigo }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Método</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.metodo }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Vigente hasta</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:600; color:#475569; border-bottom:1px solid #E2E8F0;\">{{ $('Preparar datos').item.json.vence }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:9px 0 2px 0; font-size:13px; color:#64748B;\">Monto</td>\n                        <td style=\"padding:9px 0 2px 0; font-size:18px; font-weight:800; color:#059669;\">US$ {{ $('Preparar datos').item.json.monto }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 auto;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ $('Preparar datos').item.json.wa_asesor }}\" style=\"display:inline-block; background-color:#0B4A3F; color:#FFFFFF; text-decoration:none; padding:12px 26px; border-radius:12px; font-size:12px; font-weight:800; letter-spacing:1px; text-transform:uppercase;\">\n                      Escribirle por WhatsApp →\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"background-color:#111827; padding:20px 28px; border-top:3px solid #10B981; text-align:center;\">\n              <p style=\"margin:0; font-size:11px; color:#94A3B8; line-height:1.5;\">\n                {{ $('Preparar datos').item.json.fecha }} · Generado automáticamente por el sistema de pagos MAXIMUS\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
