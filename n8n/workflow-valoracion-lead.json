    {
      "parameters": {
        "fromEmail": "CRM MAXIMUS <alertas@maximusinmobiliaria.com>",
        "toEmail": "={{ $json.email_empresa }}",
        "subject": "=🏠 [TASACIÓN] Nueva propiedad para captar: {{ $json.tipo_propiedad }} en {{ $json.ubicacion }}",
        "emailType": "html",
        "html": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Alerta de Captación: Nueva Solicitud de Valoración | MAXIMUS Inmobiliaria</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#F4F7F6; font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F4F7F6; padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <!-- Contenedor Principal -->\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px; width:100%; background-color:#FFFFFF; border-radius:20px; overflow:hidden; box-shadow:0 12px 32px rgba(11, 74, 63, 0.10); border:1px solid #E2E8F0;\">\n          \n          <!-- Barra Superior Cromo & Esmeralda -->\n          <tr>\n            <td style=\"height:6px; background:linear-gradient(90deg, #0B4A3F 0%, #10B981 50%, #CBD5E1 100%);\"></td>\n          </tr>\n\n          <!-- Cabecera con Identidad del Logo MAXIMUS -->\n          <tr>\n            <td align=\"center\" style=\"background:linear-gradient(135deg, #071714 0%, #0B4A3F 100%); padding:36px 32px 30px 32px; border-bottom:2px solid #10B981;\">\n              <div style=\"display:inline-block; width:56px; height:56px; line-height:56px; border-radius:16px; background-color:rgba(255,255,255,0.08); border:1px solid rgba(203, 213, 225, 0.35); margin-bottom:14px; text-align:center;\">\n                <span style=\"font-size:26px; font-weight:900; color:#F8FAFC; letter-spacing:-1px;\">M</span><span style=\"font-size:26px; font-weight:900; color:#10B981;\">↗</span>\n              </div>\n              <h1 style=\"margin:0; font-size:26px; font-weight:800; letter-spacing:2px; color:#F8FAFC; text-transform:uppercase;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span>\n              </h1>\n              <p style=\"margin:4px 0 0 0; font-size:11px; font-weight:700; letter-spacing:4px; color:#CBD5E1; text-transform:uppercase;\">\n                INMOBILIARIA\n              </p>\n            </td>\n          </tr>\n\n          <!-- Cuerpo del Mensaje -->\n          <tr>\n            <td style=\"padding:40px 36px 32px 36px;\">\n              <!-- Badge Alerta Interna -->\n              <div style=\"margin-bottom:20px;\">\n                <span style=\"display:inline-block; background-color:#ECFDF5; border:1px solid #A7F3D0; color:#059669; border-radius:999px; padding:6px 14px; font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;\">\n                  ⚡ Alerta Interna de Captación · Prioridad Alta\n                </span>\n              </div>\n\n              <h2 style=\"margin:0 0 12px 0; font-size:22px; font-weight:800; color:#0F172A; line-height:1.3;\">\n                Nuevo Propietario Solicita Tasación de Inmueble\n              </h2>\n\n              <p style=\"margin:0 0 24px 0; font-size:15px; line-height:1.65; color:#475569;\">\n                Se ha registrado un nuevo lead de captación desde la plataforma web oficial de <strong style=\"color:#0B4A3F;\">MAXIMUS Inmobiliaria</strong>. Se recomienda asignar un asesor captador de inmediato para contactar al propietario en las próximas 2 horas.\n              </p>\n\n              <!-- Tarjeta de Datos del Propietario / Inmueble -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F8FAFC; border:1px solid #E2E8F0; border-left:4px solid #10B981; border-radius:14px; margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:24px;\">\n                    <p style=\"margin:0 0 14px 0; font-size:11px; font-weight:800; letter-spacing:1.5px; color:#0B4A3F; text-transform:uppercase;\">\n                      Ficha Técnica del Lead de Captación\n                    </p>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding:8px 0; font-size:13px; color:#64748B; width:40%; border-bottom:1px solid #E2E8F0;\">ID de Registro:</td>\n                        <td style=\"padding:8px 0; font-size:14px; font-weight:800; color:#10B981; border-bottom:1px solid #E2E8F0; font-family:monospace;\">#{{ $json.lead_id }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Dirección / Zona del Inmueble:</td>\n                        <td style=\"padding:8px 0; font-size:14px; font-weight:700; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $json.direccion }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Correo del Propietario:</td>\n                        <td style=\"padding:8px 0; font-size:14px; font-weight:700; color:#0B4A3F; border-bottom:1px solid #E2E8F0;\">\n                          <a href=\"mailto:{{ $json.email }}\" style=\"color:#0B4A3F; text-decoration:underline;\">{{ $json.email }}</a>\n                        </td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Canal de Origen:</td>\n                        <td style=\"padding:8px 0; font-size:13px; font-weight:700; color:#334155; border-bottom:1px solid #E2E8F0;\">{{ $json.origen }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:8px 0; font-size:13px; color:#64748B;\">Fecha y Hora de Recepción:</td>\n                        <td style=\"padding:8px 0; font-size:13px; font-weight:600; color:#475569;\">{{ $json.fecha }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Botones de Acción Rápida -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"mailto:{{ $json.email }}?subject=Valoraci%C3%B3n%20de%20su%20Inmueble%20en%20MAXIMUS%20Inmobiliaria%20(Ref.%20{{ $json.lead_id }})\" style=\"display:inline-block; background:linear-gradient(135deg, #0B4A3F 0%, #10B981 100%); color:#FFFFFF; text-decoration:none; padding:14px 28px; border-radius:12px; font-size:13px; font-weight:800; letter-spacing:1px; text-transform:uppercase; box-shadow:0 6px 16px rgba(16, 185, 129, 0.25);\">\n                      Contactar al Propietario Ahora →\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer Oscuro & Plata -->\n          <tr>\n            <td style=\"background-color:#111827; padding:28px 32px; border-top:3px solid #10B981; text-align:center;\">\n              <p style=\"margin:0 0 6px 0; font-size:14px; font-weight:800; color:#F8FAFC; letter-spacing:1.5px;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span> <span style=\"font-weight:500; font-size:11px; color:#CBD5E1; letter-spacing:2px;\">INMOBILIARIA</span>\n              </p>\n              <p style=\"margin:0 0 14px 0; font-size:12px; color:#94A3B8; line-height:1.5;\">\n                Experiencia, exclusividad y respaldo legal en cada inversión.<br>\n                San Cristóbal, Estado Táchira · Venezuela\n              </p>\n              <p style=\"margin:0; font-size:11px; color:#64748B;\">\n                © 2026 MAXIMUS Inmobiliaria. Todos los derechos reservados.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {}
      },
