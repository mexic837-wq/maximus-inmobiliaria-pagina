      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "Tesorería MAXIMUS <finanzas@maximusinmobiliaria.com>",
        "toEmail": "={{ $json.asesor_email }}, {{ $json.email_empresa }}",
        "subject": "=🏆 [CIERRE DE VENTA {{ $json.inmueble_codigo }}] Liquidación de Comisión: ${{ $json.ganancia_asesor_usd }} USD",
        "emailType": "html",
        "html": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Comprobante de Cierre y Liquidación de Comisión | MAXIMUS Inmobiliaria</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#F4F7F6; font-family:'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#111827; -webkit-font-smoothing:antialiased;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F4F7F6; padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <!-- Contenedor Principal -->\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px; width:100%; background-color:#FFFFFF; border-radius:20px; overflow:hidden; box-shadow:0 12px 32px rgba(11, 74, 63, 0.10); border:1px solid #E2E8F0;\">\n          \n          <!-- Barra Superior Cromo & Esmeralda -->\n          <tr>\n            <td style=\"height:6px; background:linear-gradient(90deg, #0B4A3F 0%, #10B981 50%, #CBD5E1 100%);\"></td>\n          </tr>\n\n          <!-- Cabecera con Identidad del Logo MAXIMUS -->\n          <tr>\n            <td align=\"center\" style=\"background:linear-gradient(135deg, #071714 0%, #0B4A3F 100%); padding:36px 32px 30px 32px; border-bottom:2px solid #10B981;\">\n              <div style=\"display:inline-block; width:56px; height:56px; line-height:56px; border-radius:16px; background-color:rgba(255,255,255,0.08); border:1px solid rgba(203, 213, 225, 0.35); margin-bottom:14px; text-align:center;\">\n                <span style=\"font-size:26px; font-weight:900; color:#F8FAFC; letter-spacing:-1px;\">M</span><span style=\"font-size:26px; font-weight:900; color:#10B981;\">↗</span>\n              </div>\n              <h1 style=\"margin:0; font-size:26px; font-weight:800; letter-spacing:2px; color:#F8FAFC; text-transform:uppercase;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span>\n              </h1>\n              <p style=\"margin:4px 0 0 0; font-size:11px; font-weight:700; letter-spacing:4px; color:#CBD5E1; text-transform:uppercase;\">\n                INMOBILIARIA\n              </p>\n            </td>\n          </tr>\n\n          <!-- Cuerpo del Mensaje -->\n          <tr>\n            <td style=\"padding:40px 36px 32px 36px;\">\n              <!-- Badge Estado -->\n              <div style=\"margin-bottom:20px;\">\n                <span style=\"display:inline-block; background-color:#ECFDF5; border:1px solid #A7F3D0; color:#059669; border-radius:999px; padding:6px 14px; font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;\">\n                  🏆 Operación Cerrada · Estatus: {{ $json.estatus_comision }}\n                </span>\n              </div>\n\n              <h2 style=\"margin:0 0 12px 0; font-size:22px; font-weight:800; color:#0F172A; line-height:1.3;\">\n                Comprobante Oficial de Cierre y Estado de Comisión\n              </h2>\n\n              <p style=\"margin:0 0 24px 0; font-size:15px; line-height:1.65; color:#475569;\">\n                ¡Felicitaciones, <strong style=\"color:#0B4A3F;\">{{ $json.asesor_nombre }}</strong>! Se ha registrado formalmente el cierre de operación en la plataforma financiera de <strong style=\"color:#0B4A3F;\">MAXIMUS Inmobiliaria</strong>. A continuación se detalla el desglose oficial de liquidación de honorarios.\n              </p>\n\n              <!-- Tarjeta Destacada Honorarios del Asesor -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:linear-gradient(135deg, #071714 0%, #0B4A3F 100%); border-radius:16px; margin-bottom:24px; border:1px solid #10B981;\">\n                <tr>\n                  <td style=\"padding:24px 28px;\" align=\"center\">\n                    <p style=\"margin:0 0 6px 0; font-size:11px; font-weight:800; letter-spacing:2px; color:#10B981; text-transform:uppercase;\">\n                      Honorarios Netos del Asesor ({{ $json.asesor_porcentaje_neto }}%)\n                    </p>\n                    <p style=\"margin:0 0 6px 0; font-size:30px; font-weight:900; color:#F8FAFC; letter-spacing:0.5px;\">\n                      {{ $json.comision_neta_asesor }}\n                    </p>\n                    <p style=\"margin:0; font-size:12px; color:#CBD5E1;\">\n                      Estado actual de liquidación: <strong style=\"color:#10B981; text-transform:uppercase;\">{{ $json.estatus_comision }}</strong>\n                    </p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Desglose Financiero y Operativo -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F8FAFC; border:1px solid #E2E8F0; border-left:4px solid #10B981; border-radius:14px; margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:22px 24px;\">\n                    <p style=\"margin:0 0 14px 0; font-size:11px; font-weight:800; letter-spacing:1.5px; color:#0B4A3F; text-transform:uppercase;\">\n                      Desglose de la Operación Inmobiliaria\n                    </p>\n                    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; width:44%; border-bottom:1px solid #E2E8F0;\">Propiedad Negociada:</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:800; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $json.inmueble_titulo }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Tipo de Operación:</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#0B4A3F; border-bottom:1px solid #E2E8F0; text-transform:uppercase;\">{{ $json.tipo_operacion }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Cliente / Comprador:</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#334155; border-bottom:1px solid #E2E8F0;\">{{ $json.comprador_nombre }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Precio Final de Cierre:</td>\n                        <td style=\"padding:7px 0; font-size:15px; font-weight:800; color:#0F172A; border-bottom:1px solid #E2E8F0;\">{{ $json.precio_final }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Comisión Bruta ({{ $json.comision_bruta_porcentaje }}%):</td>\n                        <td style=\"padding:7px 0; font-size:14px; font-weight:800; color:#059669; border-bottom:1px solid #E2E8F0;\">{{ $json.comision_bruta_monto }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B; border-bottom:1px solid #E2E8F0;\">Retención / Split Oficina:</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:700; color:#475569; border-bottom:1px solid #E2E8F0;\">{{ $json.comision_oficina_monto }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding:7px 0; font-size:13px; color:#64748B;\">Fecha de Cierre:</td>\n                        <td style=\"padding:7px 0; font-size:13px; font-weight:600; color:#475569;\">{{ $json.fecha_cierre }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- CTA Button -->\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://maximusinmobiliaria.com/dashboard.html\" style=\"display:inline-block; background:linear-gradient(135deg, #0B4A3F 0%, #10B981 100%); color:#FFFFFF; text-decoration:none; padding:15px 32px; border-radius:12px; font-size:13px; font-weight:800; letter-spacing:1px; text-transform:uppercase; box-shadow:0 6px 16px rgba(16, 185, 129, 0.25);\">\n                      Ver Mis Comisiones en el CRM →\n                    </a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer Oscuro & Plata -->\n          <tr>\n            <td style=\"background-color:#111827; padding:28px 32px; border-top:3px solid #10B981; text-align:center;\">\n              <p style=\"margin:0 0 6px 0; font-size:14px; font-weight:800; color:#F8FAFC; letter-spacing:1.5px;\">\n                MAXIMUS<span style=\"color:#10B981;\">.</span> <span style=\"font-weight:500; font-size:11px; color:#CBD5E1; letter-spacing:2px;\">INMOBILIARIA</span>\n              </p>\n              <p style=\"margin:0 0 14px 0; font-size:12px; color:#94A3B8; line-height:1.5;\">\n                Experiencia, exclusividad y respaldo legal en cada inversión.<br>\n                San Cristóbal, Estado Táchira · Venezuela\n              </p>\n              <p style=\"margin:0; font-size:11px; color:#64748B;\">\n                © 2026 MAXIMUS Inmobiliaria. Todos los derechos reservados.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {}
      },
