        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><meta name=\"color-scheme\" content=\"light only\"><title>Visita agendada</title></head>\n<body style=\"margin:0;padding:0;background-color:#F4F7F6;font-family:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F4F7F6;padding:32px 16px;\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background-color:#FFFFFF;border-radius:20px;overflow:hidden;border:1px solid #E2E8F0;\">\n<tr><td style=\"height:6px;background:linear-gradient(90deg,#0B4A3F 0%,#10B981 50%,#CBD5E1 100%);\"></td></tr>\n<tr><td align=\"center\" style=\"background:linear-gradient(135deg,#071714 0%,#0B4A3F 100%);padding:30px 32px 24px 32px;border-bottom:2px solid #10B981;\">\n<img src=\"{{ $json.logo_url }}\" width=\"64\" alt=\"MAXIMUS\" style=\"display:block;width:64px;height:auto;margin:0 auto 12px auto;border:0;font-size:14px;font-weight:800;color:#F8FAFC;\">\n<h1 style=\"margin:0;font-size:22px;font-weight:800;letter-spacing:2px;color:#F8FAFC;text-transform:uppercase;\">MAXIMUS<span style=\"color:#10B981;\">.</span></h1>\n<p style=\"margin:4px 0 0 0;font-size:11px;font-weight:700;letter-spacing:4px;color:#CBD5E1;text-transform:uppercase;\">INMOBILIARIA</p></td></tr>\n<tr><td style=\"padding:34px 36px 28px 36px;\">\n<span style=\"display:inline-block;background-color:#ECFDF5;border:1px solid #A7F3D0;color:#059669;border-radius:999px;padding:6px 14px;font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;\">📅 Visita agendada</span>\n<h2 style=\"margin:16px 0 10px 0;font-size:20px;font-weight:800;color:#0F172A;line-height:1.3;\">{{ $json.asesor }} agendó una visita con {{ $json.cliente }}</h2>\n<p style=\"margin:0;font-size:14px;line-height:1.6;color:#475569;\">Desde el CRM se confirmó esta visita. {{ $json.tiene_whatsapp ? 'Al cliente se le envió el aviso por WhatsApp.' : 'El cliente no tiene teléfono válido: avísale por otro medio.' }}{{ $json.tiene_email ? ' También recibió un correo.' : '' }}</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#F8FAFC;border:1px solid #E2E8F0;border-left:4px solid #10B981;border-radius:14px;margin:18px 0 22px 0;\"><tr><td style=\"padding:18px 22px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Cliente</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.cliente }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Teléfono</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.telefono_cliente || \"N/D\" }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Inmueble</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.inmueble }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Fecha</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.fecha }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Hora</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.hora }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;border-bottom:1px solid #E2E8F0;\">Punto de encuentro</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #E2E8F0;\">{{ $json.lugar }}</td></tr><tr><td style=\"padding:7px 0;font-size:13px;color:#64748B;width:34%;\">Notas</td><td style=\"padding:7px 0;font-size:13px;font-weight:700;color:#0F172A;\">{{ $json.notas || \"—\" }}</td></tr></table></td></tr></table><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:0 auto;\"><tr><td align=\"center\"><a href=\"{{ $json.url_whatsapp_cliente }}\" style=\"display:inline-block;background-color:#0B4A3F;color:#FFFFFF;text-decoration:none;padding:14px 30px;border-radius:12px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;\">Escribirle al cliente →</a></td></tr></table>\n</td></tr>\n<tr><td style=\"background-color:#111827;padding:22px 32px;border-top:3px solid #10B981;text-align:center;\">\n<p style=\"margin:0 0 4px 0;font-size:13px;font-weight:800;color:#F8FAFC;letter-spacing:1.5px;\">MAXIMUS<span style=\"color:#10B981;\">.</span> <span style=\"font-weight:500;font-size:11px;color:#CBD5E1;letter-spacing:2px;\">INMOBILIARIA</span></p>\n<p style=\"margin:0;font-size:11px;color:#94A3B8;line-height:1.5;\">Aviso interno · generado automáticamente por el CRM MAXIMUS</p></td></tr>\n</table></td></tr></table></body></html>",
