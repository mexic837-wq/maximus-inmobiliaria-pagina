{
    "name": "maximus-inmobiliaria",
    "version": "1.0.0",
    "description": "MAXIMUS Inmobiliaria Web",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "build:app": "npm run build:css && node scripts/build-app.js",
        "cap:sync": "npm run build:app && npx cap sync",
        "cap:android": "npx cap open android",
        "cap:ios": "npx cap open ios",
        "cap:add:android": "npx cap add android",
        "cap:add:ios": "npx cap add ios",
        "build:apk": "npm run build:app && npx cap sync android && cd android && .\\\\gradlew.bat assembleDebug && cd .. && copy android\\\\app\\\\build\\\\outputs\\\\apk\\\\debug\\\\app-debug.apk MAXIMUS_Inmobiliaria.apk",
        "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.input.css -o assets/css/landing.css --minify"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@capacitor/android": "^8.6.0",
        "@capacitor/app": "^8.1.2",
        "@capacitor/browser": "^8.0.5",
        "@capacitor/core": "^8.6.0",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.6.0",
        "@capacitor/network": "^8.0.1",
        "@capacitor/push-notifications": "^8.1.3",
        "@capacitor/share": "^8.0.3",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.4"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.6.0",
        "tailwindcss": "^3.4.19"
    }
}
