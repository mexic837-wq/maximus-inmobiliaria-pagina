# ==============================================================================
# MAXIMUS INMOBILIARIA - Plantilla de Variables de Entorno Seguras
# ==============================================================================
# IMPORTANTE: Nunca subas el archivo .env con valores reales a repositorios públicos.
# Este archivo .env.example sirve exclusivamente como guía de configuración.

# Supabase VPS Producción
SUPABASE_URL=https://db.maximusinmobiliaria.tech
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY_AQUI_SOLO_BACKEND

# Webhooks n8n Automatización
N8N_BASE_URL=https://n8n.maximusinmobiliaria.tech
N8N_WEBHOOK_SECRET=TU_N8N_WEBHOOK_SECRET_AQUI
COMPANY_NOTIFY_EMAIL=contacto@maximus.com

# Almacenamiento
STORAGE_BUCKET=inmuebles-fotos
